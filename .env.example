# make up fills workspace settings and connections below automatically.
# Authenticate with the Databricks CLI first. .env is local and ignored by Git.
AIRFLOW_PORT=8080
AIRFLOW_LOCAL_ADMIN_PASSWORD=admin
AIRFLOW_SOURCE_REF=main

# Optional selectors. Empty values use the CLI default profile and reuse the
# configured app, or create airflow-durable-agent-demo in a fresh workspace.
DATABRICKS_PROFILE=
DATABRICKS_APP_NAME=
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-20b

# HTTPS base URL of a Databricks App running DurableAgentServer.
# Do not append /api/invocations or use a Model Serving endpoint.
DATABRICKS_AGENT_APP_URL=https://YOUR-APP.databricksapps.com

# Workspace OAuth service principal with CAN_USE on the app. PATs do not work.
# Single quotes preserve literal $ characters in Docker Compose env files.
AIRFLOW_CONN_DATABRICKS_OAUTH='{"conn_type":"databricks","host":"https://YOUR-WORKSPACE.cloud.databricks.com","login":"YOUR-CLIENT-ID","password":"YOUR-CLIENT-SECRET","extra":{"service_principal_oauth":true}}'

# Only needed for databricks_agent_as_tool: the LLM running AgentOperator.
# make up fills this connection with a short-lived Databricks OAuth token.
# To refresh only this token manually, run: make refresh-llm-token
# To use another available model, pass --model to scripts/refresh_databricks_llm_token.py.
# make up and make e2e refresh the token and reload .env on every run.
AIRFLOW_CONN_PYDANTICAI_DEFAULT='{"conn_type":"pydanticai","host":"https://YOUR-WORKSPACE.cloud.databricks.com/serving-endpoints","password":"YOUR-DATABRICKS-OAUTH-TOKEN","extra":{"model":"openai-chat:databricks-gpt-oss-20b"}}'
